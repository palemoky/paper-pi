# ========================================
# 🎯 核心配置 (最常修改)
# ========================================

# 显示模式: dashboard, quote, poetry, wallpaper
DISPLAY_MODE=dashboard

# 时区 (IANA 时区名称)
TIMEZONE=Asia/Shanghai

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ========================================
# ⏰ 刷新与静默配置 (常用)
# ========================================

# 静默时间段 (24小时制，在此时间段内不刷新屏幕)
QUIET_START_HOUR=1
QUIET_END_HOUR=6

# 各模式独立刷新间隔 (秒)
REFRESH_INTERVAL_DASHBOARD=600      # Dashboard: 10分钟
REFRESH_INTERVAL_QUOTE=3600         # Quote: 1小时
REFRESH_INTERVAL_POETRY=3600        # Poetry: 1小时
REFRESH_INTERVAL_WALLPAPER=0        # Wallpaper: 0=不刷新，随机壁纸建议3600+
REFRESH_INTERVAL_HOLIDAY=86400      # Holiday: 1天
REFRESH_INTERVAL_YEAR_END=86400     # Year-end: 1天

# 默认刷新间隔 (秒，用于向后兼容)
REFRESH_INTERVAL=600

# 诗词/名言缓存时长（小时）
QUOTE_CACHE_HOURS=1

# ========================================
# 👤 个人信息 (常用于节日祝福)
# ========================================

USER_NAME=Palemoky
BIRTHDAY=11-22      # MM-DD 格式
ANNIVERSARY=05-20   # MM-DD 格式

# 问候语配置
GREETING_LABEL=Palemoky
GREETING_TEXT="Stay Focused"

# ========================================
# 🌐 API 密钥 (Dashboard 模式必需)
# ========================================

# Weather (OpenWeatherMap) - https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here
CITY_NAME=Beijing

# GitHub Stats
GITHUB_USERNAME=your_username
GITHUB_TOKEN=your_token

# VPS Info (64clouds/BandwagonHost) - https://bwh88.net/clientarea.php
VPS_API_KEY=your_key_here

# Claude Code Usage
# 从 security find-generic-password -s "Claude Code-credentials" -w 获取的 accessToken
CLAUDE_OAUTH_TOKEN=
# 推荐：容器内只读挂载 token 文件路径（优先于 CLAUDE_OAUTH_TOKEN）
CLAUDE_OAUTH_TOKEN_FILE=/run/secrets/claude_oauth_token

# ChatGPT / Codex Usage
# 必填：从 ~/.codex/auth.json 获取的 access_token
CHATGPT_OAUTH_TOKEN=
# 推荐：容器内只读挂载 token 文件路径（优先于 CHATGPT_OAUTH_TOKEN）
CHATGPT_OAUTH_TOKEN_FILE=/run/secrets/chatgpt_oauth_token
# 可选：多账号场景可指定账号 ID
CHATGPT_ACCOUNT_ID=
# 可选：默认 https://chatgpt.com/backend-api
CHATGPT_BASE_URL=https://chatgpt.com/backend-api

# Kimi Code Usage
# 必填：Kimi Code API key（可从 ~/.kimi/config.toml 的 provider 配置获取）
KIMI_API_KEY=
# 推荐：容器内只读挂载 token 文件路径（优先于 KIMI_API_KEY）
KIMI_API_KEY_FILE=/run/secrets/kimi_api_key
# 可选：默认 https://api.kimi.com/coding/v1
KIMI_BASE_URL=https://api.kimi.com/coding/v1
# 可选：兼容 bbtag 示例脚本变量名（与 KIMI_BASE_URL 二选一）
KIMI_CODE_BASE_URL=

# 宿主机 secrets 目录（会只读挂载到相对于 docker-compose.yml 的 secrets 路径）
PAPER_PI_SECRETS_DIR=./secrets

# ========================================
# 🎨 模式专属配置
# ========================================

# --- Poetry 模式 ---
# 诗词 API 配置（默认使用公开在线接口）
# 如需私有接口，可覆盖为你自己的 URL
POETRY_API_URL="https://poetry.palemoky.com/api/poems/random?lang=zh-Hant&type=五言絕句&type=七言絕句&type=五言律詩&type=七言律詩"

# --- Wallpaper 模式 ---
# 壁纸名称（留空则随机选择）
WALLPAPER_NAME=

# ========================================
# ✅ TODO 数据源配置 (可选功能)
# ========================================

# 数据源类型: config, gist, notion, sheets
TODO_SOURCE=config

# TODO 显示时间段（小时范围，逗号分隔）
# 示例: "0-12,18-24" 表示 0-12点和18-24点显示 TODO
# 其他时间段自动显示 HackerNews
TODO_TIME_SLOTS=0-12,18-24

# --- GitHub Gist (if TODO_SOURCE=gist) ---
# Create a private gist with todo.md file at https://gist.github.com
GIST_ID=

# --- Notion (if TODO_SOURCE=notion) ---
# Create integration at https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Google Sheets (if TODO_SOURCE=sheets) ---
# Create service account and download credentials.json
# Guide: https://developers.google.com/sheets/api/quickstart/python
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

# ========================================
# 📰 HackerNews 配置 (可选功能)
# ========================================

# HackerNews 缓存刷新间隔（分钟）
HACKERNEWS_REFRESH_MINUTES=60

# 每页显示时长（秒）
HACKERNEWS_PAGE_SECONDS=30

# 每页显示条数
HACKERNEWS_STORIES_PER_PAGE=5

# HackerNews Gist 集成（可选）
# 设置后，每次刷新 HN 数据时会自动将帖子列表写入指定的 Gist
# 在 https://gist.github.com 创建一个 Gist，然后填入 Gist ID
HACKERNEWS_GIST_ID=

# ========================================
# 🔧 硬件配置
# ========================================

# E-Paper 型号
EPD_MODEL=epd7in5_V2

# 4级灰度模式 (启用后使用白色/浅灰/深灰/黑色四个层次，提升视觉效果)
# 设置为 false 则使用传统黑白模式
HARDWARE_USE_GRAYSCALE=true

# 模拟模式 (开发/测试用，不连接实际硬件)
MOCK_EPD=false

# 截图模式 (生成 PNG 而非显示到屏幕)
IS_SCREENSHOT_MODE=false
